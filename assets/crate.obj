# crate -- a UV test object, not art.
#
# Each of the six faces is mapped to a different region of the texture, so a
# wrong winding, a flipped V axis or a mixed-up index list is visible at a
# glance instead of hiding behind a plausible-looking cube.
#
# Exported the way Blender would: 1-based indices, v/vt/vn triples, quads.
# bake.ps1 triangulates and converts to the integer mesh text the game reads.

o crate

v -0.250000 -0.250000  0.250000
v  0.250000 -0.250000  0.250000
v  0.250000  0.250000  0.250000
v -0.250000  0.250000  0.250000
v -0.250000 -0.250000 -0.250000
v  0.250000 -0.250000 -0.250000
v  0.250000  0.250000 -0.250000
v -0.250000  0.250000 -0.250000

# Six 0.32-wide patches, one per face, spread across the texture.
vt 0.010000 0.010000
vt 0.330000 0.010000
vt 0.330000 0.330000
vt 0.010000 0.330000

vt 0.340000 0.010000
vt 0.660000 0.010000
vt 0.660000 0.330000
vt 0.340000 0.330000

vt 0.670000 0.010000
vt 0.990000 0.010000
vt 0.990000 0.330000
vt 0.670000 0.330000

vt 0.010000 0.340000
vt 0.330000 0.340000
vt 0.330000 0.660000
vt 0.010000 0.660000

vt 0.340000 0.340000
vt 0.660000 0.340000
vt 0.660000 0.660000
vt 0.340000 0.660000

vt 0.670000 0.340000
vt 0.990000 0.340000
vt 0.990000 0.660000
vt 0.670000 0.660000

vn  0.0000  0.0000  1.0000
vn  0.0000  0.0000 -1.0000
vn  1.0000  0.0000  0.0000
vn -1.0000  0.0000  0.0000
vn  0.0000  1.0000  0.0000
vn  0.0000 -1.0000  0.0000

f 1/1/1 2/2/1 3/3/1 4/4/1
f 6/5/2 5/6/2 8/7/2 7/8/2
f 2/9/3 6/10/3 7/11/3 3/12/3
f 5/13/4 1/14/4 4/15/4 8/16/4
f 4/17/5 3/18/5 7/19/5 8/20/5
f 5/21/6 6/22/6 2/23/6 1/24/6
