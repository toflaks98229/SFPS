// SFPS entity definitions.
//
// Only what the engine reads today is declared. See ../README.md for why, and
// for the units these boxes are measured in.

@SolidClass = worldspawn : "The level itself. Every brush not owned by another entity belongs here."
[
    message(string) : "Level title" : "" : "Not read yet."
    next(string) : "Level the exit leads to" : "" : "Empty means this is the last one."
]

// --- Markers -------------------------------------------------------------
//
// Points with a radius, not volumes: these are what level_exit_at and
// level_push_at have always asked about, and a pad you step onto is a place
// rather than a room.

@PointClass size(-12 -12 -12, 12 12 12) color(120 255 120) = info_exit : "Standing here ends the level. Where it goes is worldspawn's `next`."[]

// The shrine a cleared wave pays at, when assets/loot.txt says `at altar`.
// Place one where you want the reward to land and the players to have to go;
// place none and the reward falls at their feet the way it always did. A map
// may carry several -- the nearest to the player is the one that is used, so
// an arena with two arenas in it works without anything being told which is
// which.
@PointClass size(-16 -16 0, 16 16 8) color(255 210 120) = info_altar : "Where a cleared wave's reward lands. Needs `at altar` in loot.txt. Nearest one to the player wins." []

@PointClass size(-12 -12 -12, 12 12 12) color(120 200 255) = info_push : "A jump pad. Fires once per landing, while grounded."
[
    speed(integer) : "Launch speed, units per second" : 416
]

// The player, as a box, so clearance can be judged against it rather than
// guessed: 1.80m tall and 0.70m across at 1/32 m per unit. The origin sits 32
// up -- one metre, one grid square -- so an entity snapped to the grid stands
// with its feet exactly on the floor.
@baseclass size(-11 -11 -32, 11 11 26) color(0 255 0) = PlayerBox []

@PointClass base(PlayerBox) = info_player_start : "Where the player begins the level."
[
    angle(integer) : "Facing" : 90
]

// A door is a group of brushes that moves. How far it travels is not authored:
// it slides its own size along the direction it opens, less the lip. Resize the
// door and the travel follows.
@SolidClass color(0 128 220) = func_door : "Brushes that move when opened."
[
    angle(choices) : "Opens toward" : -1 =
    [
        -1 : "up"
        -2 : "down"
        0 : "east"
        90 : "north"
        180 : "west"
        270 : "south"
    ]
    speed(integer) : "Units per second" : 100
    lip(integer) : "Units left behind" : 8
    targetname(target_source) : "Name a trigger can point at"
    key(choices) : "Keycard it demands" : 0 =
    [
        0 : "none"
        1 : "red"
        2 : "blue"
        4 : "yellow"
    ]
]

// A volume, not a wall: level.c marks a trigger's brushes not-solid so the
// player can stand in one. Texture them `trigger` and the editor greys them
// out. Linked to what it fires by name -- `target` here, `targetname` there.
//
// There is no once-only trigger in this engine, so trigger_once loads as a
// trigger_multiple. A door that reopens is nearer what the name promises than
// refusing the map would be.
@SolidClass color(220 220 60) = trigger_multiple : "Fires its target while something stands in it."
[
    target(target_destination) : "What it opens"
]
@SolidClass color(220 220 60) = trigger_once : "Same, and this engine does not forget."
[
    target(target_destination) : "What it opens"
]

// Lava, acid, a burning grate. Shares the trigger_ prefix and nothing else:
// it fires no target and it never stops. Its brushes are not solid but they
// ARE drawn, so give them a material and the volume is the liquid -- the same
// arrangement Quake uses. Damage is per SECOND, and the whole box counts, so
// standing beside a knee-deep pool is safe and wading in is not.
@SolidClass color(255 90 40) = trigger_hurt : "Hurts whatever stands in it. Per second."
[
    dmg(integer) : "Damage per second" : 5
]

// A teleporter, in Quake's two halves: the volume you walk into and the point
// it puts you at. Link them with target/targetname the way a door is linked.
//
// The destination's `angle` is which way you FACE on arrival, not which way you
// are thrown -- your speed is kept and turned with you, so running in is
// running out. It is the one thing in this game that moves the view without the
// mouse, so point it somewhere the player can read the room from.
//
// A trigger_teleport whose target names nothing loads as nothing at all: the
// volume stays walkable and no teleport happens. Half a mechanism is worse than
// none, and dropping the player at the world origin is usually dropping them
// inside rock.
@SolidClass color(140 90 220) = trigger_teleport : "Walk in here, come out at the info_teleport_destination named by `target`."
[
    target(target_destination) : "Destination's targetname"
]

@PointClass size(-12 -12 -12, 12 12 12) color(140 90 220) = info_teleport_destination : "Where a trigger_teleport puts you. `angle` is which way you face."
[
    targetname(target_source) : "Name a trigger_teleport can target"
    angle(integer) : "Facing on arrival" : 0
]

// A point light. `light` is Quake's brightness and this engine reads it as
// reach, because it separates reach from brightness and Quake does not.
// Baked into the vertices when the level loads, shadowed against the brushes.
@PointClass size(-8 -8 -8, 8 8 8) color(255 255 128) = light : "A static light, baked at load."
[
    light(integer) : "Reach in units" : 300
    _color(color255) : "Colour" : "255 255 255"
]

// --- Monsters ------------------------------------------------------------
//
// The classname's suffix IS the kind enemy.c claims: level.c strips `monster_`
// and hands the rest through unchanged. A new monster is a row in enemy.c's
// table and a line here.
//
// THREE KINDS, AND THE LIST IS THE BESTIARY. `monster_imp`, `monster_hound` and
// `monster_wraith` were here and are gone: the hound and the wraith stopped
// being rows in enemy.c, and `imp` had already stopped being one before that.
//
// A .map that still says one of those three STILL LOADS. enemy.c's MON_LEGACY
// resolves each retired name to whatever replaced it -- `hound` to the water
// spirit, `imp` and `wraith` to the caster -- so an old level fills instead of
// arriving half-empty. What is gone is the editor's offer of them: TrenchBroom
// will show an existing one as an unknown class with a default box, which is
// the right amount of complaining. Repoint it and the complaint goes away.

@baseclass size(-16 -16 -32, 16 16 32) color(220 60 60) = Monster []

@PointClass base(Monster) = monster_water_spirit : "Water spirit. The baseline. Holds mid range and sprays a cone of bolts rather than closing." []
@PointClass base(Monster) = monster_brute : "Brute. A wall with health; slow, and hits hard." []

// A monster that HOLDS THE HEIGHT IT IS PLACED AT, and the reason it needs a
// box of its own rather than the one above.
//
// For everything else the origin's Z is only where the search for a floor
// begins -- level.c calls it that, and the monster settles onto whatever is
// under the marker. So the Monster box hangs 32 below the origin: snap to the
// grid and the drawn feet sit on the floor the monster will actually find.
//
// A flyer does not do that. make_monster keeps `from_y` when the kind carries
// MON_FLIES, so the origin IS the feet and the box has to sit ON the origin
// instead of below it. With the Monster box a caster would draw one metre
// lower than it flies -- an editor that disagrees with the game about where a
// thing is, which is worse than no box at all.
//
// 17 x 61 units is the caster's own 0.546m radius and 1.90m height at 1/32 m
// per unit, rather than the shared 32 x 64. It was 13 x 50 while the wraith
// wore this box; the wraith's row is gone, MON_FLIES moved onto the caster, and
// a box measured for a creature that no longer exists is a box that lies.
// Something you cannot always reach is worth measuring: the clearance under it
// is the space the player fights in.
//
// STILL A BASECLASS WITH ONE USER, on purpose. monster_spawner_caster needs
// exactly these numbers and cannot inherit them -- an @PointClass may name one
// base and that one is already Spawner -- so it writes them out and this
// comment is where the pair is recorded. Change the caster's size in enemy.c
// and BOTH lines move.
@baseclass size(-17 -17 0, 17 17 61) color(120 170 230) = Flyer []

@PointClass base(Flyer) = monster_caster : "Caster. Holds the air and throws bolts; the only kind that is not on the floor. PLACED HEIGHT IS KEPT -- put the origin where the feet should hover." []

// --- The boss fight ------------------------------------------------------
//
// Two kinds of marker and neither behaves like anything else in this file.
//
// monster_maw is a monster the way the others are, but it is NOT created at
// load: enemy_spawn_level records where it stood and the fight decides when
// there is one. Story mode raises it immediately; endless mode raises it every
// few waves. Place exactly one. A second is ignored -- the later marker wins,
// because the last thing written is the position that is kept.
//
// info_ward_* mark where a ward MAY appear, which is a kind of statement no
// other entity here makes: every other marker says a thing IS here. Each cycle
// the fight raises a random few, avoiding the ones the previous cycle used, so
// PLACE MORE THAN WILL BE USED -- at least twice as many of each kind as the
// fight raises, or "somewhere new" cannot be satisfied and positions repeat.
//
// They are info_ rather than monster_ on purpose. A ward standing in a room
// with no boss would make every boss that later arrives invulnerable from its
// first frame, and there is deliberately no classname that can put one in a
// level directly.
//
// A map with NO ward candidates does not break: the maw is simply open from
// the moment it arrives and the fight is whatever the player's damage is. The
// `wardcand` counter says so in a debug build.

@PointClass size(-48 -48 0, 48 48 192) color(200 40 40) = monster_maw : "The Maw. A stationary boss embedded in a wall. Invulnerable while any ward stands. PLACED HEIGHT IS KEPT. Place one." []

@PointClass size(-16 -16 -16, 16 16 16) color(255 200 40) = info_ward_air : "Ward slot (air). Summons casters and water spirits -- the only marker in the game that can put a flyer in the room. PLACED HEIGHT IS KEPT -- put it where the ward should hang. Place several; a few are used each cycle." []

@PointClass size(-16 -16 -16, 16 16 16) color(255 120 40) = info_ward_ground : "Ward slot (ground). Summons brutes and water spirits; never a flyer. Place several; a few are used each cycle." []

// --- Spawners ------------------------------------------------------------
//
// One class per monster because the NAME carries which one, the same way a
// sprite name carries its frame number. That costs a line here and saves a
// second field on every entity in the level.
//
// ONE PER ROW IN enemy.c's TABLE, AND EXACTLY ONE. Three monsters, three
// spawners, and the list below is checkable against the bestiary by reading
// it. `monster_spawner_imp`, `monster_spawner_hound` and
// `monster_spawner_wraith` were here; the first named a kind that had already
// been renamed, and the other two named kinds that no longer exist. A .map that
// still carries one keeps working -- see the note under Monsters -- but the
// editor no longer offers a spawner that delivers something other than what its
// name says.
//
// The maw and the ward have no spawner and are not an omission: the maw is
// raised by the fight at its own marker, and a ward is placed as an info_ward_*
// candidate. Both are up under "The boss fight".
//
// `count` 0 means it never stops. `maxalive` is a ceiling on the monsters in
// the whole level while it runs, and leaving it 0 on an endless spawner will
// fill the monster pool and keep raising the capacity counter.

@baseclass size(-16 -16 -32, 16 16 32) color(255 140 0) = Spawner
[
    wait(integer) : "Seconds between spawns" : 5
    count(integer) : "How many in total (0 = endless)" : 0
    maxalive(integer) : "Monsters alive in the level (0 = no ceiling)" : 0
]

@PointClass base(Spawner) = monster_spawner_water_spirit : "Keeps making water spirits." []
@PointClass base(Spawner) = monster_spawner_brute : "Keeps making brutes." []

// The spawner carries the height too: spawners_of stores the marker's origin
// and every caster it makes appears at that Z, so this box sits on the origin
// for the same reason monster_caster's does. Size and colour are the Flyer
// baseclass's numbers written out, because an @PointClass may name only one
// base and this one has already spent it on Spawner; wait/count/maxalive still
// come from there.
//
// PUT AIR UNDER IT. A caster spawner sitting on the floor makes casters that
// hover at ankle height for their whole lives -- the flag is not broken, the
// marker is. assets/maps/import-librequake.py lifts it two metres off a
// deathmatch start for exactly this reason, and tools/wavetest.c measures it on
// the shipped arena.
@PointClass base(Spawner) size(-17 -17 0, 17 17 61) color(120 170 230) = monster_spawner_caster : "Keeps making casters, at the height it is placed. Give it air underneath." []

// --- Items ---------------------------------------------------------------
//
// Same rule as the monsters: `item_` is stripped and pickup.c claims the rest.
// Weapon ammo is `<weapon>ammo`, which is how pickup.c reads it.

@baseclass size(-12 -12 -12, 12 12 12) color(60 200 255) = Item []

@PointClass base(Item) = item_health : "Health." []
@PointClass base(Item) = item_ammo : "Ammo for whatever is held." []
@PointClass base(Item) = item_shotgun : "The shotgun." []
@PointClass base(Item) = item_shotgunammo : "Shells." []
@PointClass base(Item) = item_rapid : "The rapid gun." []
@PointClass base(Item) = item_rapidammo : "Rapid ammunition." []
@PointClass base(Item) = item_grenade : "The grenade launcher." []
@PointClass base(Item) = item_grenadeammo : "Grenades." []
@PointClass base(Item) = item_axe : "The axe." []
@PointClass base(Item) = item_axeammo : "Axe charges." []

@PointClass base(Item) color(220 40 40) = item_redkey : "Red keycard." []
@PointClass base(Item) color(40 80 220) = item_bluekey : "Blue keycard." []
@PointClass base(Item) color(220 200 40) = item_yellowkey : "Yellow keycard." []
