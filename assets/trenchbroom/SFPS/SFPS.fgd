// SFPS entity definitions for TrenchBroom.
//
// ONLY WHAT THE ENGINE READS TODAY IS DECLARED HERE, and that is deliberate.
// An FGD is a promise to the author: everything in this list can be placed and
// will do something. Declaring the monsters and pickups now -- which the plan
// gets to in step 4 -- would let somebody build a populated level out of
// entities nothing parses, and the level would load looking empty with no
// error anywhere to explain it. Each one is added here in the commit that
// makes the engine read it.
//
// 오늘 엔진이 읽는 것만 선언하며 이는 의도적입니다. FGD는 제작자에 대한 약속입니다. 이 목록에
// 있는 모든 것은 배치할 수 있고 무언가를 합니다. 계획의 4단계에 해당하는 몬스터와 아이템을
// 지금 선언하면, 누군가 아무것도 파싱하지 않는 엔티티로 붐비는 레벨을 만들 수 있게 되고, 그
// 레벨은 비어 보이는 채로 로드되며 그것을 설명해 줄 오류는 어디에도 없습니다. 각각은 엔진이
// 그것을 읽게 되는 커밋에서 이곳에 추가됩니다.
//
// Units: 1 = 1/32 m, so grid 32 is a metre. See BRUSH_UNIT in src/brush.h.

@SolidClass = worldspawn : "The level itself. Every brush not owned by another entity belongs here."
[
    message(string) : "Level title" : "" : "Shown when the level begins. Not read yet; step 4."
]

// The player, as a box, so clearance can be judged against it rather than
// guessed. 1.80m tall and 0.70m across at 1/32 m per unit is 58 by 22 units;
// the origin sits 32 up -- one metre, one grid square -- so an entity snapped
// to the grid stands with its feet exactly on the floor.
// PLAYER_EYE is 1.70 and PLAYER_RADIUS 0.35 in src/player.h; the 26 above the
// origin is the remaining 0.80m of a 1.80m body.
//
// 플레이어를 상자로 나타내어 여유 공간을 추측이 아니라 그것에 대고 판단할 수 있게 합니다.
// 유닛당 1/32 m에서 높이 1.80m, 폭 0.70m는 58 x 22 유닛입니다. 원점은 32 위에 있으며(1미터,
// 그리드 한 칸) 따라서 그리드에 맞춘 엔티티는 발이 정확히 바닥에 닿은 채 섭니다.
@baseclass size(-11 -11 -32, 11 11 26) color(0 255 0) = PlayerBox []

@PointClass base(PlayerBox) = info_player_start : "Where the player begins the level."
[
    // Quake's convention: degrees counted from +x toward +y, so 0 is east and
    // 90 is north. The engine's yaw runs about a different axis and the two
    // differ by exactly 90 -- tools/mapview.c does the conversion and says why.
    // Quake의 관례입니다. +x에서 +y 쪽으로 센 각도이므로 0이 동쪽, 90이 북쪽입니다. 엔진의
    // yaw는 다른 축을 중심으로 돌며 둘은 정확히 90도 차이가 납니다. tools/mapview.c가 그
    // 변환을 수행하며 이유를 적어 두었습니다.
    angle(integer) : "Facing" : 90
]

// A door is a group of brushes that moves. Nothing about that is a special
// case in the loader: BrushEnt records the brushes an entity owns as a run, and
// brush_geometry takes a run -- so the leaf builds by itself and as part of the
// room through the same function.
//
// NOT SIMULATED YET. brush_parse reads it, tools/mapview.c draws it, and it
// stands still. Making it move is step 3, where door.c stops moving a Sector
// and starts moving a brush group. It is declared now because atrium.map
// already uses it and an undeclared classname is an entity TrenchBroom cannot
// show properly.
//
// 문은 움직이는 브러시 그룹입니다. 그 무엇도 로더의 특수 처리가 아닙니다. BrushEnt는 엔티티가
// 소유한 브러시를 연속 구간으로 기록하고 brush_geometry는 구간을 받으므로, 문짝은 같은 함수를
// 통해 홀로도, 방의 일부로도 생성됩니다.
//
// 아직 시뮬레이션되지 않습니다. brush_parse가 읽고 tools/mapview.c가 그리며, 가만히 서 있습니다.
// 움직이게 만드는 것은 3단계이며, 그곳에서 door.c가 Sector가 아니라 브러시 그룹을 움직이기
// 시작합니다. 지금 선언하는 이유는 atrium.map이 이미 쓰고 있고, 선언되지 않은 classname은
// TrenchBroom이 제대로 보여 줄 수 없는 엔티티이기 때문입니다.
@SolidClass color(0 128 220) = func_door : "Brushes that move when opened. Not simulated yet -- step 3."
[
    angle(choices) : "Opens toward" : -1 =
    [
        -1 : "up"
        -2 : "down"
          0 : "east"
         90 : "north"
        180 : "west"
        270 : "south"
    ]
    speed(integer) : "Units per second" : 100
]
